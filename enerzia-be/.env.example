# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env

# development | staging | production
# Outside production, the OTP endpoint returns devCode so sign-in is testable
# without an SMS provider. Never set this to anything but production in prod.
APP_ENV=development
PORT=8080

# How often the abandoned-reservation sweeper runs. Optional; defaults to 1m.
#
# The sweeper WRITES: it marks expired pending_payment orders and returns their
# stock to the catalogue. Set this to 0 to switch it off entirely — do that
# whenever you point a local process at a database whose data must not change,
# such as the live Atlas cluster. Leave it unset in deployed environments.
SWEEPER_INTERVAL=

# MongoDB Atlas. Take the SRV string from Atlas → Connect → Drivers, and
# URL-encode any special characters in the password (@ : / ? # [ ] %).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=enerzia

# Separate database for optional smoke tests against a real Atlas cluster.
# Tests never use this URI by default — the in-process mongotest fake runs
# them offline. Provide it only if you want an end-to-end Atlas smoke test.
MONGO_TEST_URI=

# HS256 signing key, minimum 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Comma-separated origins allowed to call the API (the Next.js dev server).
ALLOWED_ORIGINS=http://localhost:3000

# Razorpay — see schema.md §Razorpay
# KEY_ID is public and safe to send to the browser (used to initialise Checkout).
# KEY_SECRET and WEBHOOK_SECRET are server-only and must never leave this process.
# All three are required in production; outside production they are optional and
# the gateway falls back to Unconfigured (every call returns an error).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin catalogue — see roadmap.md §Admin
# The single administrator account. There is no admins collection and no sign-up:
# the account IS this configuration, so nothing at runtime can create one.
# ADMIN_PASSWORD_HASH is a BCRYPT HASH, never the password itself. Generate it
# with `make admin-password`, which reads the password on stdin and prints only
# the hash — the plaintext is never written to a file, a log, or a response.
# Both are required in production; empty leaves admin sign-in unconfigured, and
# every attempt then fails exactly as a wrong password does.
#
# QUOTE THE HASH. A bcrypt hash contains $ signs ($2a$10$...), and `make run`
# sources this file with `. ./.env`, so an unquoted value has $2a, $10 and the
# rest expanded away as shell variables — a 60-character hash arrives at the
# server as 38 characters of rubbish and every sign-in fails with "Email or
# password is incorrect." Single quotes, not double: double quotes still expand.
#   ADMIN_PASSWORD_HASH='$2a$10$abcdef...'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=''

# Cloudinary — see roadmap.md §POST /admin/uploads/signature
# Product photographs are uploaded by the browser straight to Cloudinary using a
# signature this server mints; the files never pass through this process and only
# their URLs are stored in Mongo.
# CLOUD_NAME and API_KEY are public by Cloudinary's design and are sent to the
# browser. API_SECRET is server-only and must never leave this process.
# Required in production; an empty cloud name selects Unconfigured, which fails
# every signing call.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional; defaults to enerzia/products
CLOUDINARY_FOLDER=

# MSG91 — see roadmap.md §Auth
# Server-only key for the widget token verification API (POST /auth/session).
# Required in production; outside production an empty value selects Unconfigured,
# which rejects every call with a 401.
MSG91_AUTH_KEY=

# Shipping origin — the return address printed on every 4x6 label.
# All six or none: a partly filled origin fails at startup rather than printing
# a label missing the line that gets an undelivered parcel home.
# Unset, GET /admin/orders/{id}/label answers 503 and nothing else is affected.
# QUOTE any value containing spaces — `make run` sources this file with `.`,
# so an unquoted `SHIP_FROM_NAME=Enerzeia Future Farm` runs `Future` as a
# command and the variable arrives empty.
SHIP_FROM_NAME="Enerzeia Future Farm"
SHIP_FROM_LINE1="Plot 14, Sector 58"
SHIP_FROM_CITY=Faridabad
SHIP_FROM_STATE=Haryana
# exactly 6 digits
SHIP_FROM_PIN=121004
# exactly 10 digits, no +91, no spaces
SHIP_FROM_PHONE=9812345678

# Transactional email (order confirmations). All-or-nothing: a from-address
# with no host sends nothing at all, silently. Unset, mail is switched off and
# nothing else is affected — a payment never fails because mail is down.
# QUOTE any value containing spaces.
SMTP_HOST=
# defaults to 587 (STARTTLS). 465 is implicit TLS.
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Enerzeia Future Farm"
