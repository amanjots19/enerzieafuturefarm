# Next.js admin console. Install: /etc/systemd/system/enerzia-admin.service
[Unit]
Description=Enerzia admin console (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enerzia
Group=enerzia
WorkingDirectory=/srv/enerzia/current/enerzia-admin

EnvironmentFile=-/etc/enerzia/admin.env
Environment=NODE_ENV=production
Environment=PORT=3001

ExecStart=/usr/bin/npm run start

Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=enerzia-admin

[Install]
WantedBy=multi-user.target
