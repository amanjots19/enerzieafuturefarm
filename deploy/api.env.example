# Production environment for the Go API.
#
# Install as /etc/enerzia/api.env, owned by root, mode 0600:
#   sudo install -d -m 0750 /etc/enerzia
#   sudo install -m 0600 api.env.example /etc/enerzia/api.env
#   sudo nano /etc/enerzia/api.env
#
# This is a systemd EnvironmentFile, NOT a shell script. Do not write `export`.
# QUOTE any value containing spaces — same trap that broke `make run` locally.

APP_ENV=production
PORT=8080

# ─── The one that looks like an outage when it is wrong ──────────────────────
# Every browser origin allowed to call this API. Miss one and the API answers
# 200 with no CORS header, the browser discards every response, and the site
# shows "Unable to reach the server" — indistinguishable from a dead backend.
# No trailing slashes. https, not http.
ALLOWED_ORIGINS=https://enerzeiafuturefarm.com,https://www.enerzeiafuturefarm.com,https://admin.enerzeiafuturefarm.com

# ─── Database ────────────────────────────────────────────────────────────────
# Add this VM's public IP to Atlas → Network Access first, or every request
# fails at connect with a timeout that looks like a hung server.
MONGO_URI=
MONGO_DB=enerzia

# ─── Secrets ─────────────────────────────────────────────────────────────────
# At least 32 characters. Generate: openssl rand -base64 48
# Changing this signs every shopper out and invalidates every admin session.
JWT_SECRET=

# ─── Razorpay (LIVE) — all three required in production ──────────────────────
# From the Razorpay dashboard in LIVE mode, not test.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you create the webhook. See the runbook: the webhook is the ONLY
# thing that records how an order was paid for.
RAZORPAY_WEBHOOK_SECRET=

# ─── MSG91 — required in production ──────────────────────────────────────────
# Server-side auth key. The widget id and token are client-side and live in the
# storefront's build environment instead.
MSG91_AUTH_KEY=

# ─── Admin sign-in — required in production ──────────────────────────────────
ADMIN_EMAIL=
# bcrypt hash, never the password. Generate with: make admin-password
# Contains $ characters — quote it.
ADMIN_PASSWORD_HASH=""

# ─── Cloudinary — required in production ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=enerzia/products

# ─── Shipping label origin — optional, all six or none ───────────────────────
# Unset, the label endpoint answers 503 and nothing else is affected.
SHIP_FROM_NAME=""
SHIP_FROM_LINE1=""
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_PIN=
SHIP_FROM_PHONE=

# ─── Transactional email — optional ──────────────────────────────────────────
# Unset, order confirmations are simply not sent and nothing else changes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Enerzeia Future Farm"
