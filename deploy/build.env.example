# Build-time values for the Next.js frontends.
#
# Install as /etc/enerzia/build.env, readable by the service user because
# deploy.sh runs as `enerzia`:
#   sudo install -m 0640 -o root -g enerzia build.env.example /etc/enerzia/build.env
#
# These are NOT secrets. Anything prefixed NEXT_PUBLIC_ is compiled into the
# JavaScript bundle and visible to every visitor. They live in a file so they
# are not committed, and so a rebuild cannot silently omit them.
#
# They are read at BUILD time. Setting them in systemd does nothing: by then
# the value is already baked into the bundle.

# MSG91 sign-in widget. From the MSG91 dashboard, OTP -> Widget.
# The server-side MSG91_AUTH_KEY is different and belongs in api.env.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
