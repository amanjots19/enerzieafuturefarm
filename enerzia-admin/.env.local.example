# Base URL for all API requests. Override when the API runs somewhere other
# than localhost:8080. The NEXT_PUBLIC_ prefix is required — env vars without
# it are stripped from the client bundle and arrive as undefined in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# CORS note: the API's ALLOWED_ORIGINS defaults to http://localhost:3000 (the
# storefront). This app runs on port 3001, so you must add
# http://localhost:3001 to ALLOWED_ORIGINS in enerzia-be/.env before sign-in
# can work. A missing entry looks like a network error, not a 401.
